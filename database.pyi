async def unban_user(user_id: int) -> None: ...
async def regenerate_user_code(user_id: int) -> str: ...
async def register_user(user_id: int, referrer_id: int | None = None) -> UserStats: ...
async def get_user_stats(user_id: int) -> UserStats: ...
async def update_user_setting(user_id: int, key: str, value: str) -> None: ...
async def waste_priority_message(user_id: int) -> None: ...
async def increment_sent_count(user_id: int) -> None: ...
async def increment_received_count(user_id: int) -> None: ...
async def add_message(
    admin_msg_id: int,
    sender_id: int,
    anon_code: str,
    is_priority: bool,
    user_msg_id: int,
) -> None: ...
async def get_admin_msg_id_by_user_msg_id(
