class UserStats:
    balance: int
    air_purchased: int
    priority_messages: int
    sent_count: int
    received_count: int
    is_vip: bool
    anon_code: str
    code_auto_refresh: str
    show_vip_cats: bool
    show_air: bool
    show_priority: bool
    show_sent: bool
    show_received: bool
    show_achievements: bool

class SenderWithMessage:
    sender_id: int
    user_msg_id: int

class SenderWithCode:
    sender_id: int
    anon_code: str

class BannedUser:
    user_id: int
    anon_code: str

class PaymentRecord:
    charge_id: str
    user_id: int
    payload: str | None
    status: str

async def init_db(db_path: str = ...) -> None: ...
async def is_banned(user_id: int) -> bool: ...
